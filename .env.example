# ==============================================================================
# LexiGuard Environment Configuration (.env.example)
# Copy this file to .env.local and populate the secrets.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (Database, Auth, Storage, pgvector)
# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# AI Provider (Anthropic Claude)
# Official Anthropic API Key for clause analysis, redlines, and executive summaries
ANTHROPIC_API_KEY="sk-ant-api03-your-anthropic-key"
ANALYSIS_MODEL="claude-3-5-haiku-20241022"
REWRITE_MODEL="claude-3-5-sonnet-20241022"
SUMMARY_MODEL="claude-3-5-sonnet-20241022"

# Embeddings Provider (Voyage AI default, fallback: OpenAI or local vector similarity)
VOYAGE_API_KEY="pa-your-voyage-api-key"
EMBEDDING_PROVIDER="voyage" # options: "voyage", "openai", "local"
EMBEDDING_MODEL="voyage-3"   # 1024 dimensions
OPENAI_API_KEY=""           # optional fallback for text-embedding-3-small (1024 dims)

# Rate Limiting (Upstash Redis optional; in-memory fallback enabled by default for local dev)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Node Environment
NODE_ENV="development"
